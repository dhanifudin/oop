# Generated build artifacts. Everything here is reproduced by `make`
# (see Makefile / scripts/render-all.sh) from source under:
#   assets/uml/src/*.puml, assets/illustrations/src/*.svg,
#   assets/screenshots/pertemuan-NN/*.png, jobsheets/assets/code-src/,
#   jobsheets/assets/header.tex, slides/id|en/*.md, jobsheets/id|en/*.md.
# `archive/` is a frozen historical snapshot excluded from the active
# pipeline, so its own generated files are committed as-is (not ignored).

# Python venv used by scripts/render-code.py and friends.
/scripts/.venv/

# Rendered PlantUML diagrams (source lives in assets/uml/src/*.puml).
/assets/uml/*.png
/slides/assets/uml/
/jobsheets/assets/uml/

# Copies of hand-authored illustrations/screenshots (source lives in
# assets/illustrations/src/ and assets/screenshots/).
/slides/assets/illustrations/
/slides/assets/screenshots/
/jobsheets/assets/screenshots/

# Rendered code-snippet images + generated manifest (source lives in
# jobsheets/assets/code-src/).
/jobsheets/assets/code/
/jobsheets/assets/code/manifest.tsv

# Bank Mini checkpoint snapshots (generated by scripts/build-checkpoints.py).
/code/bank-mini/

# Final rendered PDFs.
/slides/build/
/jobsheets/build/

# Local staging area for the GitHub Pages site, assembled fresh by CI.
# (NOT /docs/ -- that holds the committed official RPS reference PDFs.)
/docs-site/

# OS/tooling noise.
.DS_Store
__pycache__/
*.pyc
node_modules/
.claude/
